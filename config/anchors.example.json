{
  "project": "finance-live-watcher",
  "tools": {
    "ffmpeg": "ffmpeg",
    "ffprobe": "ffprobe"
  },
  "feishu_webhook": "",
  "record": {
    "sample_rate": 16000,
    "channels": 1,
    "bitrate": "64k",
    "test_seconds": 120,
    "rw_timeout_us": 20000000,
    "reconnect_max": 5
  },
  "retention_days": 7,
  "anchors": [
    {
      "id": "douyin_example",
      "platform": "douyin",
      "name": "抖音主播示例",
      "sec_uid": "替换为主播的 sec_uid",
      "poll_windows": [["19:00", "22:00"]]
    },
    {
      "id": "bilibili_example",
      "platform": "bilibili",
      "name": "B站主播示例",
      "mid": "替换为用户 mid",
      "room_id": "替换为直播间 room_id",
      "poll_windows": [["13:00", "22:30"]]
    }
  ]
}
