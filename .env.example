# Optional OpenAI-compatible summarization endpoint.
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1/chat/completions

# Optional Feishu custom bot webhook. Keep the real value in .env only.
FEISHU_WEBHOOK=

# Local transcription defaults. auto selects CUDA when the runtime can use it.
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=
WHISPER_LANGUAGE=zh

# Delete source audio and transcripts after a successful push.
CLEANUP_AFTER_PUSH=true
